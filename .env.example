# Firebase Konfiguratsiyasi (BaaS)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Telegram Bot Integratsiyasi
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
VITE_TELEGRAM_CHAT_ID=your_telegram_chat_id_or_channel_id

# Tashqi Real-Vaqt Oltin API'lari (Real External APIs)
# 1. GoldAPI.io (Header: x-access-token)
# URL: https://www.goldapi.io/api/XAU/USD
VITE_GOLD_API_KEY=your_goldapi_key_here

# 2. Metals-API (URL param: access_key)
# URL: https://metals-api.com/api/latest?access_key=YOUR_API_KEY&base=USD&symbols=XAU
VITE_METALS_API_KEY=your_metals_api_key_here

# 3. O'zbekiston Markaziy Banki (CBU) Rasmiy Kursi (Kalit talab qilinmaydi, to'g'ridan-to'g'ri ishlaydi)
# URL: https://cbu.uz/uz/arkhiv-kursov-valyut/json/USD/
