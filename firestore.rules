rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Foydalanuvchi Admin yoki Zavod egasi ekanligini tekshirish
    function isAuthenticated() {
      return request.auth != null;
    }

    // Hodimlar login indeksi (Hodim login va parolini tekshirib kirishi uchun ochiq o'qish ruxsati)
    match /employees_index/{username} {
      allow read: true;
      allow write: if isAuthenticated();
    }

    // UID orqali zavodni topish indeksi
    match /employees_uid_index/{uid} {
      allow read, write: if isAuthenticated();
    }

    // Zavodlar va ularning hodimlari
    match /factories/{factoryId} {
      allow read, write: if isAuthenticated();
      
      match /employees/{employeeId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Ombor (xomashyo va tayyor mahsulotlar)
    match /inventory/{document=**} {
      allow read, write: if isAuthenticated();
    }
    
    // Ishlab chiqarish buyurtmalari (Ugar nazorati)
    match /production_orders/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Tranzaksiyalar (Kassa va sotuvlar)
    match /transactions/{txId} {
      allow read, write: if isAuthenticated();
    }

    // Foydalanuvchilar (RBAC)
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Tizim sozlamalari (Oltin narxlari, Telegram bot konfiguratsiyasi)
    match /settings/{docId} {
      allow read, write: if isAuthenticated();
    }
  }
}
